# Supabase (self-hosted or cloud) — copy to `.env` or `.env.local` and fill in values.
NEXT_PUBLIC_SUPABASE_URL=https://your-api-host
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PostgREST schema where app tables live (must match Postgres + PGRST exposed schemas).
NEXT_PUBLIC_SUPABASE_DB_SCHEMA=sarayamenu

# Self-hosted: sarayamenu must appear in PGRST_DB_SCHEMAS (then restart API).
# Example: PGRST_DB_SCHEMAS=public,storage,graphql_public,...,sarayamenu

# Storage bucket for images (public read). Paths: {restaurant_slug}/{placement}-{filename}
# NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=sarayamenu
